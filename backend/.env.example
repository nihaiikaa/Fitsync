# ============================================================================
# FitSync Backend Environment Variables (.env)
# ============================================================================
# Copy this file to .env before starting the Spring Boot backend:
#   cp .env.example .env
#
# Replace placeholders with your actual Supabase PostgreSQL credentials.
# ============================================================================

# 1. Server Configuration
PORT=8080
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173

# 2. Supabase PostgreSQL Connection
# ----------------------------------------------------------------------------
# Option A: Supabase Connection Pooler - SESSION MODE (Port 5432) [RECOMMENDED]
# Works seamlessly with IPv4, Spring Boot JPA, Hibernate, and Flyway migrations.
# Connection string format:
#   jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Username format:
#   postgres.<project-ref>
#
# Option B: Direct Connection (Port 5432)
# Requires an IPv6-capable network or Supabase IPv4 Add-On:
#   jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Username format:
#   postgres
#
# Option C: Supabase Connection Pooler - TRANSACTION MODE (Port 6543)
# Suitable for high-concurrency microservices. Note: If using Transaction mode,
# Flyway migrations must be executed separately or JDBC URL must include &prepareThreshold=0
# ----------------------------------------------------------------------------
SUPABASE_DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.your_project_ref_here
SUPABASE_DB_PASSWORD=your_supabase_database_password_here

# 3. Security & JWT Token Authentication
# Minimum 256 bits (32+ characters) for secure HMAC-SHA256 signature
JWT_SECRET=fitsync_super_secret_jwt_encryption_key_2026_production_grade_32_chars_minimum
JWT_EXPIRATION_MS=86400000

# 4. Spring Profile
SPRING_PROFILES_ACTIVE=prod
